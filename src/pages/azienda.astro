</Layout>
<style>
  #lightbox.open {
    display: flex;
    animation: lbFadeIn 0.25s ease both;
  }
  @keyframes lbFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
</style>
<script>
  function initDynamicTimeline() {
    const container = document.getElementById('timeline-container');
    const progressBar = document.getElementById('timeline-progress');
    const items = document.querySelectorAll('.timeline-item');

    if (!container || !progressBar || items.length === 0) return;

    const handleScroll = () => {
      const containerRect = container.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const triggerPoint = windowHeight * 0.6;
      let scrolled = triggerPoint - containerRect.top;
      let progress = (scrolled / containerRect.height) * 100;

      progress = Math.max(0, Math.min(100, progress));
      progressBar.style.height = `${progress}%`;

      items.forEach((item, index) => {
        const itemRect = item.getBoundingClientRect();
        const itemCenter = itemRect.top + (itemRect.height / 2);

        if (itemCenter < triggerPoint) {
          item.setAttribute('data-active', 'true');
        } else {
          if (index === 0 && progress <= 5) {
            item.setAttribute('data-active', 'true');
          } else {
            item.setAttribute('data-active', 'false');
          }
        }
      });
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', handleScroll);
    handleScroll();
  }

  function initLightbox() {
    const triggers = document.querySelectorAll<HTMLElement>('.lightbox-trigger');
    const lightbox = document.getElementById('lightbox');
    
    if (!lightbox || triggers.length === 0) return;

    // Aggiunto "!" per garantire a TS che l'elemento non è null
    const lbImgWrap = document.getElementById('lb-img-wrap')!;
    const lbPlaceholder = document.getElementById('lb-placeholder')!;
    const lbLabel = document.getElementById('lb-label')!;
    const lbClose = document.getElementById('lb-close')!;
    const lbPrev = document.getElementById('lb-prev')!;
    const lbNext = document.getElementById('lb-next')!;

    let currentIdx = 0;
    const triggersArray = Array.from(triggers);

    // Tipizzato idx come number
    const openLightbox = (idx: number) => {
      currentIdx = idx;
      updateLightbox();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      lightbox.classList.remove('open');
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    };

    const updateLightbox = () => {
      const item = triggersArray[currentIdx];
      const imgEl = item.querySelector('img');
      
      let label = '';
      if (imgEl && imgEl.alt) {
        label = imgEl.alt;
      } else {
        const captionEl = item.querySelector('.text-white\\/70') || item.querySelector('.text-white\\/15');
        if (captionEl) label = captionEl.textContent?.trim() || '';
      }

      lbImgWrap.querySelectorAll('img').forEach(img => img.remove());

      if (imgEl && imgEl.src) {
        lbPlaceholder.classList.add('hidden');
        const lb = document.createElement('img');
        lb.src = imgEl.src;
        lb.alt = label;
        lb.className = 'w-full h-full object-contain';
        lbImgWrap.appendChild(lb);
      } else {
        lbPlaceholder.classList.remove('hidden');
      }

      lbLabel.textContent = label;
    };

    // Tipizzato idx come number
    triggersArray.forEach((item, idx: number) => {
      item.addEventListener('click', () => openLightbox(idx));
    });

    lbClose.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', e => { if (e.target === lightbox) closeLightbox(); });

    lbPrev.addEventListener('click', () => {
      currentIdx = (currentIdx - 1 + triggersArray.length) % triggersArray.length;
      updateLightbox();
    });
    
    lbNext.addEventListener('click', () => {
      currentIdx = (currentIdx + 1) % triggersArray.length;
      updateLightbox();
    });

    document.addEventListener('keydown', e => {
      if (!lightbox.classList.contains('open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') lbPrev.click();
      if (e.key === 'ArrowRight') lbNext.click();
    });
  }

  document.addEventListener('astro:page-load', () => {
    initDynamicTimeline();
    initLightbox();
  });
</script>
