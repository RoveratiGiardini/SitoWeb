---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import { Icon } from 'astro-icon/components';

import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import logoAeronautica from '../assets/partners/aeronautica.png';
import logoBorsetti from '../assets/partners/borsetti.png';
import logoTeatro from '../assets/partners/comunale-ferrara.svg';
import logoDiscoVerde from '../assets/partners/discoverde.png';
import logoDodiciEventi from '../assets/partners/dodicieventi.png';
import logoExpo from '../assets/partners/expo-fe.svg';
import logoPanathlon from '../assets/partners/panathlon.png';
import logoWelding from '../assets/partners/welding-duebi.svg';
import logoOspedale from '../assets/partners/ospedale.png';
import logoAvis from '../assets/partners/avis.svg';

import logoImg from '../assets/icona.jpeg';
import sfondoSvg from '../assets/sfondo.svg';

// Recupero dati CMS
const [tutteTrasformazioni, tuttiServizi, impostazioniHome] = await Promise.all([
  getCollection('trasformazioni'),
  getCollection('servizi'),
  getEntry('impostazioni', 'home')
]);

const slideHome = tutteTrasformazioni[0];
const serviziEvidenza = tuttiServizi
  .filter((s: CollectionEntry<'servizi'>) => s.data.inEvidenza)
  .slice(0, 4);

const resolvedHeroImage = impostazioniHome?.data.heroImage;

type Partner = {
  name: string;
  logo: ImageMetadata;
};

const partners: Partner[] = [
  { name: 'Aeronautica Militare', logo: logoAeronautica },
  { name: 'Studio Borsetti', logo: logoBorsetti },
  { name: 'Teatro Comunale di Ferrara', logo: logoTeatro },
  { name: 'Disco Verde di Bertelli', logo: logoDiscoVerde },
  { name: 'Dodicieventi', logo: logoDodiciEventi },
  { name: 'Fiera Expo Ferrara', logo: logoExpo },
  { name: 'Panathlon', logo: logoPanathlon },
  { name: 'Welding Duebi', logo: logoWelding },
  { name: 'Ospedale di Cona', logo: logoOspedale },
  { name: 'AVIS', logo: logoAvis },
];
---

<Layout 
  title="Roverati Giardini | Progettazione e Manutenzione Aree Verdi a Ferrara"
  description="Da oltre 50 anni l'architettura del verde a Ferrara. Potature in tree climbing, irrigazione e progettazione 3D."
>
  <div class="bg-green-500 py-3 overflow-hidden select-none border-b border-green-400/30">
    <div class="marquee-track flex whitespace-nowrap">
      {Array(3).fill(null).map(() => (
        <div class="flex items-center gap-0 flex-shrink-0">
          {[
            'Architettura del Verde',
            'Tree Climbing',
            'Progettazione 3D',
            'Manutenzione Professionale',
            'Impianti di Irrigazione',
            'ISO 9001 Certificata',
            'Dagli anni \'60',
            'Ferrara e Provincia',
          ].map(item => (
            <span class="inline-flex items-center gap-4 px-8 text-sm font-semibold tracking-wide text-white/90 uppercase">
              <span class="w-1 h-1 rounded-full bg-white/50 flex-shrink-0"></span>
              {item}
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
  <section class="hero-section relative min-h-[88vh] md:min-h-screen flex items-center overflow-hidden bg-green-950">
    <div class="absolute inset-0">
      {resolvedHeroImage ? (
        <Image 
          src={resolvedHeroImage} 
          alt="Team Roverati Giardini"
          class="absolute inset-0 w-full h-full object-cover object-left md:object-center hero-img" 
          loading="eager" 
          widths={[800, 1200, 1920]} 
          sizes="100vw" 
        />
      ) : (
        <div class="absolute inset-0 bg-green-900 w-full h-full"></div>
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-green-950/95 via-green-950/30 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-green-950/60 to-transparent md:hidden"></div>
    </div>

    <div class="relative w-full max-w-7xl mx-auto px-6 pt-12 pb-24 md:pt-16 md:pb-32 z-10">
      <div class="mb-8 hidden md:block">
        <div class="hero-badge relative w-24 h-24 flex items-center justify-center">
          <svg viewBox="0 0 120 120" class="w-full h-full animate-[spin_18s_linear_infinite] absolute inset-0" fill="none">
            <path id="textCircle" d="M 60,60 m -45,0 a 45,45 0 1,1 90,0 a 45,45 0 1,1 -90,0" fill="none"/>
            <text font-size="11" fill="rgba(255,255,255,0.55)" font-family="DM Sans, sans-serif" font-weight="500" letter-spacing="3.5">
              <textPath href="#textCircle">DAL 1960 · FERRARA · VERDE ·&nbsp;</textPath>
            </text>
          </svg>
          <Image 
            src={logoImg} 
            alt="Logo Roverati Giardini" 
            class="relative z-10 w-12 h-12 rounded-full object-cover border"
            width={50}
            height={50}
          />
        </div>
      </div>

      <div class="hero-eyebrow inline-flex items-center gap-2.5 mb-7 px-4 py-2 bg-white/8 border border-white/15 backdrop-blur-md text-white/75 text-[8px] md:text-[12px] font-bold tracking-[0.28em] uppercase rounded-full">        <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse flex-shrink-0"></span>
        Ferrara e Provincia — Dal 1960
      </div>
      <h1 class="hero-headline font-display leading-[1.1] md:leading-[0.92] tracking-[-0.02em] mb-10
                 text-6xl md:text-[clamp(4.5rem,7vw,6.5rem)] text-white">
        <span class="block hero-line-1">Il tuo giardino,</span>
        <span class="block hero-line-2">
          <em class="text-green-400 not-italic">la nostra</em>
        </span>
        <span class="block hero-line-3 font-light">opera d'arte.</span>
      </h1>
      <div class="hero-bottom flex flex-col md:flex-row md:items-end gap-10 md:justify-between">
        <div class="max-w-sm">
          <p class="text-white/50 text-base leading-relaxed mb-8 font-light">
            Dalla progettazione 3D alle potature in tree climbing: 50 anni di eccellenza nel verde.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/contatti"
               class="cta-primary group inline-flex items-center gap-3 bg-green-500 hover:bg-green-400 text-white px-8 py-4 rounded-full font-semibold text-sm tracking-wide uppercase transition-all duration-300 hover:shadow-2xl hover:shadow-green-500/50 hover:-translate-y-0.5">
              Preventivo Gratuito
              <span class="w-5 h-5 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0 group-hover:bg-white/30 transition-colors">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </span>
            </a>
            <a href="/servizi"
               class="inline-flex items-center gap-2 bg-white/8 border border-white/20 hover:bg-white/15 text-white/80 hover:text-white px-7 py-4 rounded-full font-medium text-sm transition-all duration-300 backdrop-blur-sm">
              Scopri i Servizi
            </a>
            <a href="tel:+393882425127"
              class="inline-flex items-center gap-2 bg-white/8 border border-white/20 hover:bg-white/15 text-white/80 hover:text-white px-7 py-4 rounded-full font-medium text-sm transition-all duration-300 backdrop-blur-sm">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
              </svg>
              Chiama Ora
            </a>
          </div>
        </div>
        <div class="flex gap-8 md:gap-12 border-t border-white/10 pt-8 md:border-0 md:pt-0">
          {[
            { value: '50+',    label: 'Anni' },
            { value: '1.200+', label: 'Progetti' },
            { value: '98%',    label: 'Soddisfatti' },
          ].map(s => (
            <div class="flex flex-col items-center text-center">
              <span class="font-display text-3xl md:text-4xl text-white font-light tracking-tight">{s.value}</span>
              <span class="text-[10px] text-white/40 mt-1 tracking-widest uppercase font-medium">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 hidden md:flex flex-col items-center gap-2">
      <div class="w-5 h-8 rounded-full border border-white/25 flex items-start justify-center pt-1.5">
        <div class="w-0.5 h-1.5 bg-white/50 rounded-full animate-[scrollPulse_1.8s_ease-in-out_infinite]"></div>
      </div>
    </div>
  </section>

  <section class="py-28 px-6 bg-cloud">
    <div class="max-w-7xl mx-auto">
      <div class="reveal flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16">
        <div>
          <div class="flex items-center gap-3 mb-5">
            <span class="w-8 h-px bg-green-500"></span>
            <span class="text-[10px] font-bold tracking-[0.3em] uppercase text-green-500">I nostri servizi</span>
          </div>
          <h2 class="font-display text-5xl md:text-6xl text-green-900 leading-[0.92]">
            Ogni verde<br/>
            <em class="font-light text-green-500">ha la sua storia.</em>
          </h2>
        </div>
        <a href="/servizi" class="group inline-flex items-center gap-2 text-sm font-semibold text-green-700 hover:text-green-500 transition-colors self-start md:self-auto">
          Vedi tutti i servizi
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {serviziEvidenza.map((servizio: CollectionEntry<'servizi'>) => (
          <a href={`/servizi/${servizio.id}`}
            class="reveal service-card group relative bg-white rounded-3xl overflow-hidden border border-green-100 p-8 lg:p-10 flex flex-col sm:flex-row gap-6 sm:gap-8 items-start sm:items-center hover:-translate-y-1 hover:border-green-300 hover:shadow-xl hover:shadow-green-900/8 transition-all duration-500">
            
            <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-green-500 to-green-400 scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
            
            <div class="w-16 h-16 rounded-2xl bg-green-50 border border-green-200 text-green-600 group-hover:bg-green-500 group-hover:text-white group-hover:border-green-500 flex items-center justify-center flex-shrink-0 group-hover:scale-105 group-hover:shadow-lg group-hover:shadow-green-500/30 transition-all duration-300">
              <Icon name={servizio.data.icona || 'mdi:leaf'} class="w-8 h-8" aria-hidden="true" />
            </div>
            
            <div class="flex-1 min-w-0 w-full">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-xl font-semibold text-green-900 mb-1.5">{servizio.data.titolo}</h3>
                  <p class="text-sm text-green-700/60 leading-relaxed font-light">{servizio.data.descrizioneBreve}</p>
                </div>
                <div class="w-9 h-9 rounded-full border border-green-100 group-hover:bg-green-500 group-hover:border-green-500 flex items-center justify-center transition-all duration-300 flex-shrink-0 hidden sm:flex">
                  <svg class="w-4 h-4 text-green-400 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </div>
              </div>
              {servizio.data.tags && servizio.data.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {servizio.data.tags.map((tag: string) => (
                    <span class="text-[10px] bg-green-50 text-green-600 font-bold tracking-wide uppercase px-3 py-1 rounded-full border border-green-100">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-28 px-6 bg-green-950 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-40 -left-40 w-[500px] h-[500px] rounded-full bg-green-800/30 blur-3xl"></div>
      <div class="absolute -bottom-40 right-0 w-[400px] h-[400px] rounded-full bg-green-600/15 blur-3xl"></div>
    </div>
    <div class="max-w-7xl mx-auto relative">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <div class="reveal">
          <div class="flex items-center gap-3 mb-7">
            <span class="w-8 h-px bg-green-500"></span>
            <span class="text-[10px] font-bold tracking-[0.3em] uppercase text-green-500">I nostri lavori</span>
          </div>
          <h2 class="font-display text-5xl md:text-6xl text-white mb-7 leading-[0.92]">
            Un prima<br/>
            e un dopo<br/>
            <em class="text-green-400 font-light">che parlano da soli.</em>
          </h2>
          <p class="text-white/50 leading-relaxed mb-10 text-base font-light max-w-sm">
            Dimostriamo la nostra esperienza con i fatti. Trascina la barra per vedere ogni trasformazione.
          </p>
          <ul class="flex flex-col gap-4 mb-12">
            {[
              'Interventi su misura per ogni tipologia di spazio',
              'Utilizzo di specie autoctone e sostenibili',
              'Garanzia scritta su tutti i lavori eseguiti',
            ].map(item => (
              <li class="flex items-start gap-3 text-sm text-white/60 font-light">
                <span class="mt-0.5 flex-shrink-0 w-5 h-5 rounded-full bg-green-500/20 border border-green-500/40 text-green-400 flex items-center justify-center">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
          <a href="/galleria" class="inline-flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-full bg-green-500 group-hover:bg-green-400 flex items-center justify-center flex-shrink-0 transition-all duration-300 shadow-lg shadow-green-500/30">
              <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>
            <span class="text-sm font-semibold text-white/70 group-hover:text-white transition-colors tracking-wide">
              Esplora la Galleria
            </span>
          </a>
        </div>
        
        <div class="reveal">
          {slideHome && slideHome.data.immaginePrima && slideHome.data.immagineDopo ? (
             <BeforeAfterSlider 
               beforeImg={slideHome.data.immaginePrima}
               afterImg={slideHome.data.immagineDopo}
               altText={typeof slideHome.data.titolo === 'string' ? slideHome.data.titolo : slideHome.data.titolo.slug}
             />
          ) : (
             <div class="text-white/50 text-sm border border-white/10 rounded-3xl p-8 text-center bg-white/5">Nessuna trasformazione disponibile. Aggiungila da Keystatic e carica le immagini.</div>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="py-0 px-6 bg-cloud">
    <div class="max-w-7xl mx-auto">
      <div class="reveal grid grid-cols-2 md:grid-cols-4 border border-green-100 rounded-3xl overflow-hidden">
        {[
          { value: '50+',      label: 'Anni di Esperienza' },
          { value: '1.200+',   label: 'Progetti Realizzati' },
          { value: '98%',      label: 'Clienti Soddisfatti' },
          { value: 'ISO 9001', label: 'Qualità Certificata' },
        ].map((stat, i) => (
          <div class={`stat-item flex flex-col items-center text-center px-6 py-12 relative ${i < 3 ? 'border-r border-green-100' : ''} ${i >= 2 ? 'border-t border-green-100 md:border-t-0' : ''} group hover:bg-green-500 transition-colors duration-300`}>
            <span class="font-display text-4xl md:text-5xl text-green-900 group-hover:text-white tracking-tight font-light mb-1 transition-colors duration-300">{stat.value}</span>
            <span class="text-[11px] font-medium text-green-500 group-hover:text-green-100 mt-1 tracking-wide uppercase transition-colors duration-300">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-green-900 relative overflow-hidden border-t border-white/5">
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="reveal flex flex-col items-center text-center mb-16">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-px bg-green-500"></span>
          <span class="text-[10px] font-bold tracking-[0.3em] uppercase text-green-500">Si fidano di noi</span>
          <span class="w-8 h-px bg-green-500"></span>
        </div>
        <h2 class="font-display text-3xl md:text-4xl text-white font-light">
          Le eccellenze che hanno scelto la <em class="text-green-400 not-italic font-normal">nostra esperienza</em>
        </h2>
      </div>

      <div class="relative w-full flex items-center overflow-hidden">
        <div class="absolute inset-y-0 left-0 w-20 md:w-40 bg-gradient-to-r from-green-900 to-transparent z-10 pointer-events-none"></div>
        <div class="absolute inset-y-0 right-0 w-20 md:w-40 bg-gradient-to-l from-green-900 to-transparent z-10 pointer-events-none"></div>

        <div class="flex whitespace-nowrap animate-marquee-logos hover:[animation-play-state:paused]">
          {Array(2).fill(null).map(() => (
            <div class="flex items-center gap-12 md:gap-20 px-6 md:px-10 flex-shrink-0">
              {partners.map((partner) => (
                <div class="group relative flex flex-col items-center justify-center w-28 h-16 md:w-36 md:h-20 transition-all duration-500 cursor-default">
                  <Image
                    src={partner.logo} 
                    alt={`Logo ${partner.name}`} 
                    class="max-w-full max-h-full object-contain grayscale opacity-40 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300 drop-shadow-sm"
                    loading="lazy"
                  />
                  <span class="absolute -bottom-8 opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-[10px] text-white/70 tracking-wider uppercase font-medium bg-green-950/80 px-3 py-1 rounded-full backdrop-blur-sm whitespace-nowrap border border-white/10">
                    {partner.name}
                  </span>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-36 px-6 bg-cloud overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <Image 
        src={sfondoSvg} 
        alt="" 
        class="w-[1000px] md:w-[800px] max-w-none h-auto object-contain translate-y-24"
        aria-hidden="true"
      />
    </div>
    <div class="reveal relative max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-2.5 mb-8 px-5 py-2.5 rounded-full border border-green-200 bg-green-50">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        <span class="text-[10px] font-bold tracking-[0.28em] uppercase text-green-600">Inizia Oggi</span>
      </div>
      <h2 class="font-display text-5xl md:text-7xl text-green-900 mb-6 leading-[0.92]">
        Trasformiamo il tuo<br/>
        <em class="text-green-500 font-light">spazio verde insieme.</em>
      </h2>
      <p class="text-lg text-green-700/60 mb-12 max-w-xl mx-auto leading-relaxed font-light">
        Sopralluogo gratuito, preventivo in 48 ore. Raccontaci il tuo progetto e lo realizziamo.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contatti"
           class="group inline-flex items-center gap-3 bg-green-500 hover:bg-green-600 text-white px-10 py-5 rounded-full font-semibold text-sm tracking-wide uppercase transition-all duration-300 hover:shadow-2xl hover:shadow-green-500/40 hover:-translate-y-1">
          Richiedi Preventivo Gratuito
          <span class="w-5 h-5 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0 group-hover:bg-white/30 transition-colors">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </span>
        </a>
        <a href="tel:+393882425127"
           class="inline-flex items-center gap-3 border-2 border-green-200 hover:border-green-500 text-green-800 hover:text-green-600 px-8 py-5 rounded-full font-semibold text-sm transition-all duration-300 hover:bg-green-50">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
          </svg>
          Chiamaci Ora
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero animations ── */
  .hero-img { animation: heroZoom 18s ease-out both; }
  @keyframes heroZoom { from { transform: scale(1.06); } to { transform: scale(1); } }

  .hero-eyebrow { animation: fadeUp 0.9s cubic-bezier(0.22,1,0.36,1) 0.2s both; }
  .hero-line-1  { animation: fadeUp 0.9s cubic-bezier(0.22,1,0.36,1) 0.35s both; }
  .hero-line-2  { animation: fadeUp 0.9s cubic-bezier(0.22,1,0.36,1) 0.48s both; }
  .hero-line-3  { animation: fadeUp 0.9s cubic-bezier(0.22,1,0.36,1) 0.61s both; }
  .hero-bottom  { animation: fadeUp 0.9s cubic-bezier(0.22,1,0.36,1) 0.75s both; }
  .hero-badge   { animation: fadeIn 1.2s ease 1s both; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(32px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ── Scroll mouse pulse ── */
